{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "openapi-catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/openapi/catalog.json"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/openapi/booking.json"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/openapi/order.json"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/openapi/payment.json"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "booking-event-seats-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/events/{eventId}/seats"
        }
      },
      "catalog-events-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "catalog-venues-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/venues/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://catalog:8080" }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://booking:8080" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://order:8080" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://payment:8080" }
        }
      }
    }
  }
}
